---
import choferes from '../data/choferes.json';
---

<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>REXI | Red de Choferes Ejecutivos</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: #f1f5f9;
      padding: 2rem 1rem;
    }
    .container { max-width: 48rem; margin: 0 auto; }
    h1 {
      text-align: center;
      font-size: 2rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 0.5rem;
    }
    .subtitle {
      text-align: center;
      color: #64748b;
      margin-bottom: 2rem;
    }
    .chofer-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .chofer-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1rem;
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      text-decoration: none;
      color: inherit;
      transition: all 0.2s;
    }
    .chofer-card:hover {
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
      transform: translateY(-2px);
    }
    .chofer-logo {
      width: 4rem;
      height: 4rem;
      border-radius: 0.75rem;
      overflow: hidden;
      flex-shrink: 0;
      background: #f8fafc;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .chofer-logo img {
      width: 80%;
      height: 80%;
      object-fit: contain;
    }
    .chofer-info { flex-grow: 1; }
    .chofer-name {
      font-size: 1.125rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 0.25rem;
    }
    .chofer-title {
      font-size: 0.875rem;
      color: #d97706;
      font-weight: 600;
      margin-bottom: 0.25rem;
    }
    .chofer-phone {
      font-size: 0.875rem;
      color: #64748b;
    }
    .arrow {
      color: #94a3b8;
      font-size: 1.5rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>REXI Movilidad</h1>
    <p class="subtitle">Red de choferes ejecutivos en Reynosa</p>
    
    <div class="chofer-list">
      {choferes.map((chofer) => (
        <a href={`/t/${chofer.id}/`} class="chofer-card">
          <div class="chofer-logo">
            <img src={`/logos/${chofer.logo}`} alt={chofer.nombre} />
          </div>
          <div class="chofer-info">
            <div class="chofer-name">{chofer.nombre}</div>
            <div class="chofer-title">{chofer.titulo}</div>
            <div class="chofer-phone">{chofer.telefonoFormateado}</div>
          </div>
          <div class="arrow">›</div>
        </a>
      ))}
    </div>
  </div>
</body>
</html>