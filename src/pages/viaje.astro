---
import Layout from '../layouts/Layout.astro';
import Credito from '../components/Credito.astro';
import { directorioPublico, negocio } from '../lib/datos';

const datos = { directorio: directorioPublico, centro: negocio.centroMapa, marca: negocio.marca, whatsapp: negocio.whatsappDueno };
---

<Layout titulo="Tu viaje en vivo" noindex referrer="origin" tema="#0f172a">
  <link slot="head" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" />

  <div class="viaje-app">
    <header class="viaje-top">
      <b>{negocio.marca}</b>
      <span class="pill" id="pill">Conectando…</span>
    </header>

    <div id="mapa" role="application" aria-label="Mapa del viaje"></div>

    <section class="hoja" id="hoja">
      <div id="vista-viaje">
        <div class="unidad">
          <div>
            <h1 id="chofer">Tu chofer</h1>
            <p id="unidad"></p>
          </div>
          <span class="placa" id="placa" hidden></span>
        </div>
        <div class="eta" id="eta" role="status" aria-live="polite">Buscando la señal del chofer…</div>
        <div class="botones">
          <button class="btn btn-amarillo full" id="compartir-yo" type="button">Compartir mi ubicación con el chofer</button>
          <button class="btn btn-borde" id="compartir-viaje" type="button">Compartir viaje</button>
          <button class="btn btn-borde" id="centrar" type="button">Centrar mapa</button>
          <a class="btn btn-verde" id="llamar" href="#">Llamar al chofer</a>
          <a class="btn btn-rojo" href="tel:911">Emergencia 911</a>
        </div>
      </div>

      <div class="fin" id="vista-fin" hidden>
        <h1 id="fin-titulo">Tu viaje terminó</h1>
        <p id="fin-texto">La ubicación ya no se muestra ni se guarda. Gracias por viajar con nosotros.</p>
        <a class="btn btn-amarillo" id="fin-tarjeta" href="/">Ver choferes</a>
      </div>
      <Credito origen="viaje" />
    </section>
  </div>

  <script type="application/json" id="datos" set:html={JSON.stringify(datos)} />
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
  <script is:inline src="/js/rexi.js"></script>
  <script is:inline src="/js/viaje.js"></script>
</Layout>

