  .viaje-app { height: 100dvh; display: grid; grid-template-rows: auto 1fr auto; }
  .viaje-top { background: #0f172a; color: #fff; display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .75rem 1rem; }
  .viaje-top b { font-weight: 800; letter-spacing: -.01em; }
