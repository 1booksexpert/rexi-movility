---
import TarjetaLayout from '../../layouts/TarjetaLayout.astro';
import choferes from '../../data/choferes.json';

export function getStaticPaths() {
  return choferes.map((chofer) => ({
    params: { id: chofer.id },
    props: { chofer }
  }));
}

const { chofer } = Astro.props;
---

<TarjetaLayout chofer={chofer} titulo={`${chofer.nombre} | REXI Movilidad`}>
  <!-- HERO: TARJETA 3D -->
  <section class="hero">
    <div class="hero-label">Tarjeta de Presentación Digital</div>
    
    <div class="perspective-1000 flip-card" onclick="toggleFlipCard()">
      <div id="flipCardInner" class="flip-card-inner transform-style-3d" style="position: relative;">
        
        <!-- FRENTE -->
        <div class="card-face card-front backface-hidden">
          <div class="logo-container">
            <img src={`/logos/${chofer.logo}`} alt="REXI" />
          </div>
          <div class="card-name">{chofer.nombre}</div>
          <div class="card-title">{chofer.titulo}</div>
          <div class="card-phone">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <span class="card-phone-number">{chofer.telefonoFormateado}</span>
          </div>
          <div class="flip-hint">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            Toca para ver el reverso
          </div>
        </div>

        <!-- REVERSO -->
        <div class="card-face card-back backface-hidden rotate-y-180">
          <div class="back-title">Servicios Premium</div>
          <ul class="services-list">
            {chofer.servicios.map((s) => (
              <li>
                <span class={`service-icon icon-${s.color}`}>{s.icono}</span>
                <span>{s.nombre}</span>
              </li>
            ))}
          </ul>
          <div class="back-bottom">
            <div>
              <div class="qr-container">
                <img id="qrCodeImage" src="" alt="QR" />
              </div>
              <div class="qr-label">Escanea para tarjeta digital</div>
            </div>
            <button class="btn-save" onclick="downloadVCard()">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Guardar en Contactos
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="actions-row">
      <button id="btnUbicacion" class="btn-action btn-location" onclick="enviarUbicacion()">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        <span id="btnUbicacionText">Enviar Ubicación</span>
      </button>
    </div>
  </section>

  <!-- SERVICIOS DETALLADOS -->
  <section class="services-section">
    <h2 class="section-title">Soluciones de Movilidad</h2>
    <p class="section-subtitle">Selecciona una opción para enviar un mensaje por WhatsApp</p>
    
    <div class="services-grid">
      <article class="service-card">
        <div class="service-card-icon" style="background: #dbeafe;"></div>
        <h3>Local y Puentes</h3>
        <p>Traslados rápidos a Hidalgo, Pharr o Anzaldúas.</p>
        <button class="btn-service" onclick="enviarWhatsApp('local')">Pedir Taxi</button>
      </article>

      <article class="service-card">
        <div class="service-card-icon" style="background: #f3e8ff;">✈️</div>
        <h3>Aeropuerto y Foráneos</h3>
        <p>Recepción en REX o traslados a Monterrey (MMTY).</p>
        <button class="btn-service" onclick="enviarWhatsApp('aeropuerto')">Cotizar Viaje</button>
      </article>

      <article class="service-card">
        <div class="service-card-icon" style="background: #ccfbf1;"></div>
        <h3>Turismo Médico</h3>
        <p>Traslados discretos a clínicas, hospitales o recogida en hotel.</p>
        <button class="btn-service" onclick="enviarWhatsApp('medico')">Reservar Traslado</button>
      </article>

      <article class="service-card">
        <div class="service-card-icon" style="background: #ffedd5;"></div>
        <h3>Paquetería Express</h3>
        <p>Envío seguro de documentos, refacciones o compras.</p>
        <button class="btn-service" onclick="enviarWhatsApp('paqueteria')">Enviar Paquete</button>
      </article>

      <article class="service-card">
        <div class="service-card-icon" style="background: #f1f5f9;"></div>
        <h3>Corporativo</h3>
        <p>Convenios para traslado de personal y facturación mensual.</p>
        <button class="btn-service" onclick="enviarWhatsApp('corporativo')">Consultar Convenio</button>
      </article>

      <article class="service-card">
        <div class="service-card-icon" style="background: #fce7f3;"></div>
        <h3>Pet-Friendly</h3>
        <p>Vehículo adaptado para mascotas. Traslados al veterinario.</p>
        <button class="btn-service" onclick="enviarWhatsApp('mascotas')">Cotizar Servicio</button>
      </article>
    </div>
  </section>

  <footer>
    <p>&copy; 2026 REXI | {chofer.nombre}. {chofer.zona}.</p>
  </footer>
</TarjetaLayout>