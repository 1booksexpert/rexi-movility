---
// src/components/admin/ZoneEditor.astro
import type { Zone } from '../types/zone';

// Datos de ejemplo (en producción, esto vendría de tu base de datos)
const currentZones: Zone[] = [
  { id: '1', name: 'Zona Centro', baseFare: 45.00, pricePerKm: 8.50, coverageArea: 'Centro Histórico, Alameda, Juárez', isActive: true },
  { id: '2', name: 'Zona Norte / Aeropuerto', baseFare: 80.00, pricePerKm: 12.00, coverageArea: 'Aeropuerto, Polanco, Lomas', isActive: true }
];
---

<div class="zone-editor-container">
  <div class="editor-header">
    <h2>Configuración de Zonas</h2>
    <p>Define tus áreas de operación y tarifas preferenciales. Transparencia total para tu cliente.</p>
  </div>

  <form id="zoneForm" class="zone-form" method="POST" action="/api/zones">
    <div id="zonesList" class="zones-grid">
      {currentZones.map((zone) => (
        <div class="zone-card" data-zone-id={zone.id}>
          <div class="zone-card-header">
            <input type="text" name="zoneName" value={zone.name} placeholder="Nombre de la Zona" required />
            <label class="toggle-switch">
              <input type="checkbox" name="isActive" checked={zone.isActive} />
              <span class="slider"></span>
            </label>
          </div>
          
          <div class="zone-card-body">
            <div class="input-group">
              <label>Tarifa Base ($)</label>
              <input type="number" name="baseFare" value={zone.baseFare} step="0.01" min="0" required />
            </div>
            <div class="input-group">
              <label>Precio por Km ($)</label>
              <input type="number" name="pricePerKm" value={zone.pricePerKm} step="0.01" min="0" required />
            </div>
            <div class="input-group full-width">
              <label>Áreas / Colonias incluidas</label>
              <textarea name="coverageArea" placeholder="Ej: Roma, Condesa, Polanco..." required>{zone.coverageArea}</textarea>
            </div>
          </div>

          <button type="button" class="btn-remove" onclick="removeZone(this)">Eliminar Zona</button>
        </div>
      ))}
    </div>

    <div class="editor-actions">
      <button type="button" id="addZoneBtn" class="btn-secondary">+ Agregar Nueva Zona</button>
      <button type="submit" class="btn-primary">Guardar Configuración</button>
    </div>
  </form>
</div>

<script>
  // Lógica para agregar/eliminar zonas dinámicamente
  document.getElementById('addZoneBtn')?.addEventListener('click', () => {
    const zonesList = document.getElementById('zonesList');
    const newId = Date.now().toString();
    
    const newZoneHTML = `
      <div class="zone-card" data-zone-id="${newId}">
        <div class="zone-card-header">
          <input type="text" name="zoneName" placeholder="Nombre de la Zona" required />
          <label class="toggle-switch">
            <input type="checkbox" name="isActive" checked />
            <span class="slider"></span>
          </label>
        </div>
        <div class="zone-card-body">
          <div class="input-group">
            <label>Tarifa Base ($)</label>
            <input type="number" name="baseFare" step="0.01" min="0" placeholder="0.00" required />
          </div>
          <div class="input-group">
            <label>Precio por Km ($)</label>
            <input type="number" name="pricePerKm" step="0.01" min="0" placeholder="0.00" required />
          </div>
          <div class="input-group full-width">
            <label>Áreas / Colonias incluidas</label>
            <textarea name="coverageArea" placeholder="Ej: Roma, Condesa..." required></textarea>
          </div>
        </div>
        <button type="button" class="btn-remove" onclick="removeZone(this)">Eliminar Zona</button>
      </div>
    `;
    zonesList!.insertAdjacentHTML('beforeend', newZoneHTML);
  });

  // @ts-ignore
  window.removeZone = function(button: HTMLButtonElement) {
    button.closest('.zone-card')?.remove();
  };
</script>

<style>
  .zone-editor-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
    font-family: 'Inter', system-ui, sans-serif;
    color: #e2e8f0;
  }
  .editor-header h2 {
    font-size: 1.8rem;
    margin: 0 0 0.5rem 0;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .editor-header p { color: #94a3b8; margin-bottom: 2rem; }
  
  .zones-grid { display: flex; flex-direction: column; gap: 1.5rem; }
  
  .zone-card {
    background: rgba(30, 41, 59, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 1.5rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .zone-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    border-color: rgba(251, 191, 36, 0.2);
  }

  .zone-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .zone-card-header input[type="text"] {
    background: transparent;
    border: none;
    font-size: 1.25rem;
    font-weight: 600;
    color: #f8fafc;
    width: 80%;
    outline: none;
  }

  /* Toggle Switch */
  .toggle-switch { position: relative; display: inline-block; width: 50px; height: 26px; }
  .toggle-switch input { opacity: 0; width: 0; height: 0; }
  .slider {
    position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
    background-color: #475569; transition: .4s; border-radius: 26px;
  }
  .slider:before {
    position: absolute; content: ""; height: 20px; width: 20px; left: 3px; bottom: 3px;
    background-color: white; transition: .4s; border-radius: 50%;
  }
  input:checked + .slider { background-color: #f59e0b; }
  input:checked + .slider:before { transform: translateX(24px); }

  .zone-card-body { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .input-group { display: flex; flex-direction: column; gap: 0.5rem; }
  .input-group.full-width { grid-column: span 2; }
  .input-group label { font-size: 0.85rem; color: #94a3b8; font-weight: 500; }
  
  .input-group input, .input-group textarea {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.75rem;
    color: #f1f5f9;
    font-size: 0.95rem;
    transition: border-color 0.2s;
  }
  .input-group input:focus, .input-group textarea:focus {
    outline: none;
    border-color: #f59e0b;
  }
  .input-group textarea { resize: vertical; min-height: 60px; }

  .btn-remove {
    margin-top: 1rem;
    background: transparent;
    border: 1px solid #ef4444;
    color: #ef4444;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s;
  }
  .btn-remove:hover { background: rgba(239, 68, 68, 0.1); }

  .editor-actions {
    display: flex;
    justify-content: space-between;
    margin-top: 2rem;
  }
  .btn-secondary, .btn-primary {
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
    font-size: 1rem;
  }
  .btn-secondary {
    background: transparent;
    border: 1px solid #f59e0b;
    color: #f59e0b;
  }
  .btn-secondary:hover { background: rgba(245, 158, 11, 0.1); }
  .btn-primary {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #0f172a;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
  }
  .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(245, 158, 11, 0.4); }

  @media (max-width: 640px) {
    .zone-card-body { grid-template-columns: 1fr; }
    .input-group.full-width { grid-column: span 1; }
    .editor-actions { flex-direction: column; gap: 1rem; }
  }
</style>