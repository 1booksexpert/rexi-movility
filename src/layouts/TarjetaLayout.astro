---
import Credito from '../components/Credito.astro';
import Accesibilidad from '../components/Accesibilidad.astro';
import AccesibilidadHead from '../components/AccesibilidadHead.astro';
import { negocio, sitioBase } from '../lib/datos';
import type { Chofer } from '../lib/datos';

export interface Props {
  chofer: Chofer;
  titulo?: string;
}

const { chofer, titulo } = Astro.props;
const tarjetaUrl = chofer.urlTarjeta;
const marca = negocio.marca;
const wsDueno = negocio.whatsappDueno;
---

<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo || `${chofer.nombre} | ${marca}`}</title>
  <meta name="description" content={`${chofer.nombre}, ${chofer.titulo} en ${chofer.zona}. Pide por WhatsApp con tu ubicación y sigue tu viaje en tiempo real.`} />
  <meta property="og:title" content={`${chofer.nombre} | ${marca}`} />
  <meta property="og:description" content={`Servicio premium 24/7 en Reynosa y la Frontera. ${chofer.telefonoFormateado}`} />
  <meta property="og:url" content={tarjetaUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={`${sitioBase()}${chofer.logo}`} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="canonical" href={tarjetaUrl} />
  <meta name="theme-color" content="#FFC72C" />
  <AccesibilidadHead />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  
  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
      color: #0f172a;
      -webkit-font-smoothing: antialiased;
      padding-bottom: 100px;
      min-height: 100vh;
    }
    
    .main-container {
      max-width: 48rem;
      margin: 0 auto;
      padding: 2rem 1rem;
    }
    
    /* FLIP CARD */
    .perspective-1000 { perspective: 1000px; }
    .transform-style-3d { transform-style: preserve-3d; }
    .backface-hidden {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .rotate-y-180 { transform: rotateY(180deg); }
    
    .flip-card-inner {
      transition: transform 0.8s cubic-bezier(0.4, 0.0, 0.2, 1);
      position: relative;
      width: 100%;
      height: 100%;
    }
    
    .flip-card-inner.is-flipped {
      transform: rotateY(180deg);
    }
    
    .flip-card {
      max-width: 22rem;
      height: 32rem;
      margin: 0 auto 2rem;
      cursor: pointer;
    }
    
    .card-face {
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 1.5rem;
      padding: 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    }
    
    .card-back {
      justify-content: flex-start;
      padding-top: 1.5rem;
    }
    
    .logo-container {
      width: 6rem;
      height: 6rem;
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .logo-container img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    
    .card-name {
      font-size: 1.875rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #0f172a;
      margin-bottom: 0.25rem;
    }
    
    .card-title {
      font-size: 0.875rem;
      font-weight: 600;
      color: #b45309;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      margin-bottom: 1.5rem;
    }
    
    .card-phone {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: #FFC72C;
      padding: 0.75rem 1.5rem;
      border-radius: 0.75rem;
    }
    
    .card-phone svg {
      color: #000000;
    }
    
    .card-phone-number {
      font-size: 1.25rem;
      font-weight: 700;
      color: #000000;
      letter-spacing: 0.02em;
    }
    
    .flip-hint {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: #475569;
      font-size: 0.9375rem;
      margin-top: 1rem;
      animation: pulse 2s infinite;
    }
    
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    
    /* BACK OF CARD */
    .back-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 1rem;
    }
    
    .services-list {
      list-style: none;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
      text-align: left;
    }
    
    .services-list li {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: #334155;
    }
    
    .service-icon-text {
      font-size: 1.25rem;
    }
    
    .back-bottom {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: 0.75rem;
      margin-top: auto;
    }
    
    .qr-container {
      background: #f8fafc;
      padding: 0.75rem;
      border-radius: 0.75rem;
      border: 1px solid #e2e8f0;
    }
    
    .qr-container img {
      width: 5rem;
      height: 5rem;
      display: block;
    }
    
    .qr-label {
      font-size: 0.8125rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #475569;
      text-align: center;
      margin-top: 0.5rem;
    }
    
    .btn-action-full {
      width: 100%;
      background: #0f172a;
      color: #ffffff;
      font-weight: 600;
      padding: 0.875rem;
      border-radius: 0.75rem;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      transition: background 0.2s;
    }
    
    .btn-action-full:hover {
      background: #1e293b;
    }
    
    .btn-location {
      background: #15803d;
    }
    
    .btn-location:hover {
      background: #15803d;
    }
    
    .btn-print {
      background: #64748b;
    }
    
    .btn-print:hover {
      background: #475569;
    }
    
    /* SERVICES GRID */
    .services-section {
      padding: 2rem 0;
    }
    
    .section-title {
      text-align: center;
      font-size: 1.5rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 0.5rem;
    }
    
    .section-subtitle {
      text-align: center;
      color: #475569;
      margin-bottom: 2rem;
      font-size: 0.9375rem;
    }
    
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
      gap: 1rem;
    }
    
    .service-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      transition: box-shadow 0.2s;
    }
    
    .service-card:hover {
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }
    
    .service-card-icon {
      font-size: 2rem;
      margin-bottom: 0.75rem;
    }
    
    .service-card h3 {
      font-size: 1.125rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 0.5rem;
    }
    
    .service-card p {
      color: #475569;
      font-size: 0.875rem;
      line-height: 1.5;
      flex-grow: 1;
      margin-bottom: 1rem;
    }
    
    .btn-service {
      width: 100%;
      background: #2563eb;
      color: #ffffff;
      font-weight: 600;
      padding: 0.75rem;
      border-radius: 0.75rem;
      border: none;
      cursor: pointer;
      font-size: 0.875rem;
      transition: background 0.2s;
    }
    
    .btn-service:hover {
      background: #1d4ed8;
    }
    
    /* COVERAGE */
    .coverage-section {
      padding: 2rem 0;
      text-align: center;
    }
    
    .coverage-tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
      margin-top: 1rem;
    }
    
    .tag {
      background: #e0f2fe;
      color: #0369a1;
      padding: 0.5rem 1rem;
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 600;
    }
    
    /* FOOTER */
    .main-footer {
      text-align: center;
      color: #475569;
      font-size: 0.875rem;
      padding: 2rem 0;
      border-top: 1px solid #e2e8f0;
      margin-top: 2rem;
    }
    
    /* STICKY BAR */
    .sticky-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border-top: 1px solid #e2e8f0;
      padding: 0.75rem;
      display: flex;
      gap: 0.75rem;
      z-index: 50;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    }
    
    .sticky-btn {
      flex: 1;
      padding: 0.875rem;
      border-radius: 0.75rem;
      font-weight: 700;
      font-size: 0.9375rem;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      color: #ffffff;
      transition: transform 0.1s;
      text-decoration: none;
    }
    
    .sticky-btn:active {
      transform: scale(0.97);
    }
    
    .sticky-call {
      background: #2563eb;
    }
    
    .sticky-wa {
      background: #15803d;
    }

    /* Accesibilidad y extras */
    :focus-visible { outline: 3px solid #FFC72C; outline-offset: 3px; }
    .flip-card:focus-visible { outline-offset: 6px; border-radius: 1.5rem; }
    @media (prefers-reduced-motion: reduce) {
      .flip-card-inner { transition: none; }
      .flip-hint { animation: none; }
    }
    .estado-ubic { max-width: 22rem; margin: -1rem auto 1.5rem; min-height: 1.25rem; font-size: .9375rem; color: #475569; text-align: center; }
    .seguimiento {
      max-width: 22rem; margin: 0 auto 2rem; padding: 1rem 1.25rem; text-align: left;
      background: #0f172a; color: #fff; border-radius: 1rem; font-size: .875rem;
    }
    .seguimiento b { display: block; font-size: .9375rem; margin-bottom: .15rem; }
    .seguimiento span { color: #cbd5e1; }
    .flip-card { height: 35rem; }
    .qr-container { display: flex; flex-direction: column; align-items: center; }
    .qr-svg { width: 4.75rem; height: 4.75rem; }
    .qr-svg svg { width: 100%; height: 100%; display: block; }
    .acceso-chofer { text-align: center; margin: 1rem 0 0; font-size: .9375rem; }
    .acceso-chofer a { color: #475569; }
    .main-footer .marca-pie { font-weight: 700; color: #0f172a; }
  </style>
</head>
<body>
  <Accesibilidad />
  <slot />
  
  <!-- STICKY BAR -->
  <div class="sticky-bar">
    <a href={`tel:+52${chofer.telefono}`} class="sticky-btn sticky-call">
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
      Llamar
    </a>
    <button class="sticky-btn sticky-wa" onclick="enviarWhatsApp('general')">
      <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
      WhatsApp
    </button>
  </div>

  <script define:vars={{ chofer, marca, wsDueno, tarjetaUrl }}>
    const CONFIG = {
      phoneNumber: chofer.telefono,
      businessName: `REXI | ${chofer.nombre}`,
      jobTitle: chofer.titulo,
      location: chofer.zona,
      currentUrl: tarjetaUrl,
      mensajes: chofer.mensajes || { general: 'Hola, necesito un servicio de transporte.' }
    };

    function toggleFlipCard() {
      const card = document.getElementById('flipCardInner');
      if (!card) return;
      const abierta = card.classList.toggle('is-flipped');
      const cont = document.getElementById('flipCard');
      if (cont) cont.setAttribute('aria-pressed', String(abierta));
    }
    function teclaTarjeta(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleFlipCard(); }
    }

    function abrirWhatsApp(texto) {
      const url = 'https://wa.me/52' + CONFIG.phoneNumber + '?text=' + encodeURIComponent(texto);
      window.location.href = url;
    }
    function enviarWhatsApp(tipo) {
      abrirWhatsApp(CONFIG.mensajes[tipo] || CONFIG.mensajes.general);
    }

    // Pide la ubicación una vez; si no se puede, sigue sin ella.
    function obtenerUbicacion() {
      return new Promise(function (ok) {
        if (!navigator.geolocation) return ok(null);
        navigator.geolocation.getCurrentPosition(
          function (p) { ok(p.coords); },
          function () { ok(null); },
          { enableHighAccuracy: true, timeout: 9000, maximumAge: 30000 }
        );
      });
    }
    function lineaUbicacion(c) {
      return 'Mi ubicación: https://maps.google.com/?q=' + c.latitude.toFixed(6) + ',' + c.longitude.toFixed(6) +
        ' (precisión aprox. ' + Math.round(c.accuracy) + ' m)';
    }
    function estado(txt) {
      const e = document.getElementById('estadoUbic');
      if (e) e.textContent = txt;
    }

    async function enviarUbicacion() {
      // El botón se toma de forma síncrona: después del await el evento ya no existe.
      const btn = (window.event && window.event.currentTarget) || null;
      const original = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Obteniendo ubicación...'; }
      const c = await obtenerUbicacion();
      if (btn) { btn.disabled = false; btn.textContent = original; }
      if (!c) {
        estado('No pudimos leer tu ubicación. Revisa el permiso del navegador; te la pediremos por WhatsApp.');
        return abrirWhatsApp('Hola, necesito un servicio de transporte. ¿Te comparto mi ubicación?');
      }
      estado('');
      abrirWhatsApp('Hola, necesito un servicio de transporte.\n' + lineaUbicacion(c));
    }

    async function pedirServicio(indice) {
      const s = chofer.servicios[indice];
      if (!s) return;
      estado('Buscando tu ubicación…');
      const c = await obtenerUbicacion();
      estado('');
      abrirWhatsApp(s.mensaje + (c ? '\n' + lineaUbicacion(c) : ''));
    }

    function downloadVCard() {
      const tel = '+52' + CONFIG.phoneNumber;
      const lineas = [
        'BEGIN:VCARD',
        'VERSION:3.0',
        'N:;' + CONFIG.businessName + ';;;',
        'FN:' + CONFIG.businessName,
        'ORG:' + marca,
        'TITLE:' + CONFIG.jobTitle,
        'TEL;TYPE=CELL,VOICE:' + tel,
        'ADR;TYPE=WORK:;;;' + CONFIG.location.split(',')[0].trim() + ';' + (CONFIG.location.split(',')[1] || '').trim() + ';;México',
        'URL:' + CONFIG.currentUrl,
        'END:VCARD'
      ];
      const blob = new Blob([lineas.join('\r\n')], { type: 'text/vcard;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'REXI_' + chofer.id + '.vcf';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
    }

    async function compartirTarjeta() {
      const d = { title: CONFIG.businessName, text: 'Movilidad ejecutiva en Reynosa', url: CONFIG.currentUrl };
      if (navigator.share) { try { await navigator.share(d); } catch (e) {} }
      else if (navigator.clipboard) { await navigator.clipboard.writeText(CONFIG.currentUrl); estado('Enlace de la tarjeta copiado.'); }
    }

    // Astro envuelve los scripts con define:vars en un bloque: se exponen a mano
    // para que funcionen los onclick del HTML.
    Object.assign(window, {
      toggleFlipCard, teclaTarjeta, enviarWhatsApp, enviarUbicacion,
      pedirServicio, downloadVCard, compartirTarjeta
    });
  </script>
</body>
</html>