---
export interface Props {
  chofer: {
    id: string;
    nombre: string;
    titulo: string;
    telefono: string;
    telefonoFormateado: string;
    zona: string;
    logo: string;
    servicios: Array<{ nombre: string; icono: string; color: string }>;
    mensajes: Record<string, string>;
  };
  titulo?: string;
}

const { chofer, titulo } = Astro.props;
const siteUrl = Astro.site?.toString() || 'https://rexi-movilidad.pages.dev';
const tarjetaUrl = `${siteUrl}t/${chofer.id}/`;
---

<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>{titulo || `${chofer.nombre} | REXI Movilidad`}</title>
  <meta name="description" content={`Chofer ejecutivo de confianza en Reynosa. ${chofer.nombre} - ${chofer.titulo}`} />
  <meta property="og:title" content={`${chofer.nombre} | REXI Movilidad Ejecutiva`} />
  <meta property="og:description" content={`Servicio premium 24/7 en Reynosa y la Frontera. ${chofer.telefonoFormateado}`} />
  <meta property="og:url" content={tarjetaUrl} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#FFC72C" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: #f1f5f9;
      color: #0f172a;
      -webkit-font-smoothing: antialiased;
      padding-bottom: 100px;
    }
    .perspective-1000 { perspective: 1000px; }
    .transform-style-3d { transform-style: preserve-3d; }
    .backface-hidden {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .rotate-y-180 { transform: rotateY(180deg); }
    .flip-card-inner {
      transition: transform 0.8s cubic-bezier(0.4, 0.0, 0.2, 1);
    }
    .flip-card-inner.is-flipped { transform: rotateY(180deg); }

    /* HERO */
    .hero {
      background: #ffffff;
      padding: 3rem 1rem 4rem;
      text-align: center;
    }
    .hero-label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #64748b;
      margin-bottom: 2rem;
    }
    .flip-card {
      max-width: 22rem;
      height: 28rem;
      margin: 0 auto;
      cursor: pointer;
    }
    .card-face {
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 1.5rem;
      padding: 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .card-front {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    }
    .card-back {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
      justify-content: flex-start;
      padding-top: 1.5rem;
    }
    .logo-container {
      width: 6rem;
      height: 6rem;
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .logo-container img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .card-name {
      font-size: 1.875rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #0f172a;
      margin-bottom: 0.25rem;
    }
    .card-title {
      font-size: 0.75rem;
      font-weight: 600;
      color: #d97706;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      margin-bottom: 1.5rem;
    }
    .card-phone {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: #FFC72C;
      padding: 0.75rem 1.5rem;
      border-radius: 0.75rem;
    }
    .card-phone svg { color: #000000; }
    .card-phone-number {
      font-size: 1.25rem;
      font-weight: 700;
      color: #000000;
      letter-spacing: 0.02em;
    }
    .flip-hint {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: #94a3b8;
      font-size: 0.75rem;
      margin-top: 1rem;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    /* BACK */
    .back-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 1rem;
      letter-spacing: -0.02em;
    }
    .services-list {
      list-style: none;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
    .services-list li {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: #334155;
    }
    .service-icon {
      width: 1.75rem;
      height: 1.75rem;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.875rem;
      flex-shrink: 0;
    }
    .icon-blue { background: #dbeafe; }
    .icon-purple { background: #f3e8ff; }
    .icon-teal { background: #ccfbf1; }
    .icon-orange { background: #ffedd5; }
    .icon-slate { background: #f1f5f9; }
    .back-bottom {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: 0.75rem;
    }
    .qr-container {
      background: #f8fafc;
      padding: 0.75rem;
      border-radius: 0.75rem;
      border: 1px solid #e2e8f0;
    }
    .qr-container img {
      width: 5rem;
      height: 5rem;
      display: block;
    }
    .qr-label {
      font-size: 0.625rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #64748b;
      text-align: center;
      margin-top: 0.5rem;
    }
    .btn-save {
      width: 100%;
      background: #0f172a;
      color: #ffffff;
      font-weight: 600;
      padding: 0.875rem;
      border-radius: 0.75rem;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      transition: background 0.2s;
    }
    .btn-save:hover { background: #1e293b; }

    /* ACTIONS */
    .actions-row {
      display: flex;
      gap: 0.75rem;
      max-width: 22rem;
      margin: 1.5rem auto 0;
    }
    .btn-action {
      flex: 1;
      padding: 0.875rem;
      border-radius: 0.75rem;
      font-weight: 600;
      font-size: 0.875rem;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: all 0.2s;
      font-family: 'Inter', sans-serif;
    }
    .btn-location {
      background: #16a34a;
      color: #ffffff;
    }
    .btn-location:hover { background: #15803d; }
    .btn-location:disabled { opacity: 0.6; cursor: not-allowed; }

    /* SERVICES GRID */
    .services-section {
      padding: 3rem 1rem;
      max-width: 64rem;
      margin: 0 auto;
    }
    .section-title {
      text-align: center;
      font-size: 1.75rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 0.5rem;
      letter-spacing: -0.02em;
    }
    .section-subtitle {
      text-align: center;
      color: #64748b;
      margin-bottom: 2rem;
      font-size: 0.9375rem;
    }
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      gap: 1rem;
    }
    .service-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      transition: box-shadow 0.2s;
    }
    .service-card:hover { box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06); }
    .service-card-icon {
      width: 3rem;
      height: 3rem;
      border-radius: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      margin-bottom: 1rem;
    }
    .service-card h3 {
      font-size: 1.125rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 0.5rem;
    }
    .service-card p {
      color: #64748b;
      font-size: 0.875rem;
      line-height: 1.5;
      flex-grow: 1;
      margin-bottom: 1rem;
    }
    .btn-service {
      width: 100%;
      background: #2563eb;
      color: #ffffff;
      font-weight: 600;
      padding: 0.75rem;
      border-radius: 0.75rem;
      border: none;
      cursor: pointer;
      font-size: 0.875rem;
      transition: background 0.2s;
    }
    .btn-service:hover { background: #1d4ed8; }

    /* FOOTER */
    footer {
      background: #ffffff;
      border-top: 1px solid #e2e8f0;
      padding: 2rem 1rem;
      text-align: center;
      color: #64748b;
      font-size: 0.875rem;
    }

    /* STICKY BAR */
    .sticky-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border-top: 1px solid #e2e8f0;
      padding: 0.75rem;
      display: flex;
      gap: 0.75rem;
      z-index: 50;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    }
    .sticky-btn {
      flex: 1;
      padding: 0.875rem;
      border-radius: 0.75rem;
      font-weight: 700;
      font-size: 0.9375rem;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      color: #ffffff;
      transition: transform 0.1s;
    }
    .sticky-btn:active { transform: scale(0.97); }
    .sticky-call { background: #2563eb; }
    .sticky-wa { background: #16a34a; }
  </style>
</head>
<body>
  <slot />
  
  <!-- STICKY BAR -->
  <div class="sticky-bar">
    <a href={`tel:+52${chofer.telefono}`} class="sticky-btn sticky-call">
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
      Llamar
    </a>
    <button class="sticky-btn sticky-wa" onclick="enviarWhatsApp('general')">
      <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
      WhatsApp
    </button>
  </div>

  <script>
    const CONFIG = {
      phoneNumber: '{chofer.telefono}',
      businessName: 'REXI | {chofer.nombre}',
      jobTitle: '{chofer.titulo}',
      location: '{chofer.zona}',
      currentUrl: window.location.href,
      mensajes: {
        local: `{chofer.mensajes.local}`,
        aeropuerto: `{chofer.mensajes.aeropuerto}`,
        medico: `{chofer.mensajes.medico}`,
        paqueteria: `{chofer.mensajes.paqueteria}`,
        corporativo: `{chofer.mensajes.corporativo}`,
        mascotas: `{chofer.mensajes.mascotas}`,
        general: `{chofer.mensajes.general}`
      }
    };

    // QR Code
    document.addEventListener('DOMContentLoaded', function() {
      const qrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&margin=10&color=0f172a&bgcolor=ffffff&data=' + encodeURIComponent(CONFIG.currentUrl);
      const qrImg = document.getElementById('qrCodeImage');
      if (qrImg) qrImg.src = qrUrl;
    });

    function toggleFlipCard() {
      const card = document.getElementById('flipCardInner');
      if (card) card.classList.toggle('is-flipped');
    }

    function enviarWhatsApp(tipo) {
      const mensaje = CONFIG.mensajes[tipo] || CONFIG.mensajes.general;
      const url = 'https://wa.me/52' + CONFIG.phoneNumber + '?text=' + encodeURIComponent(mensaje);
      window.open(url, '_blank');
    }

    function enviarUbicacion() {
      const btn = document.getElementById('btnUbicacion');
      const btnText = document.getElementById('btnUbicacionText');
      
      if (!navigator.geolocation) {
        alert('Tu navegador no soporta geolocalización.');
        enviarWhatsApp('general');
        return;
      }

      btn.disabled = true;
      btnText.textContent = 'Obteniendo ubicación...';

      navigator.geolocation.getCurrentPosition(
        function(position) {
          const lat = position.coords.latitude;
          const lng = position.coords.longitude;
          const mapsLink = 'https://www.google.com/maps?q=' + lat + ',' + lng;
          const mensaje = 'Hola, necesito un servicio de transporte. Mi ubicación actual es:\n\n' + mapsLink;
          const url = 'https://wa.me/52' + CONFIG.phoneNumber + '?text=' + encodeURIComponent(mensaje);
          window.open(url, '_blank');
          
          btn.disabled = false;
          btnText.textContent = 'Enviar Mi Ubicación';
        },
        function(error) {
          alert('No se pudo obtener la ubicación. Por favor, escríbela manualmente.');
          enviarWhatsApp('general');
          btn.disabled = false;
          btnText.textContent = 'Enviar Mi Ubicación';
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
      );
    }

    function downloadVCard() {
      const vCard = [
        'BEGIN:VCARD',
        'VERSION:3.0',
        'FN:' + CONFIG.businessName,
        'TITLE:' + CONFIG.jobTitle,
        'TEL;TYPE=CELL:+' + CONFIG.phoneNumber,
        'ADR;TYPE=WORK:;;' + CONFIG.location + ';;;;',
        'URL:' + CONFIG.currentUrl,
        'END:VCARD'
      ].join('\n');

      const blob = new Blob([vCard], { type: 'text/vcard;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'REXI_Contacto.vcf';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    }
  </script>
</body>
</html>